ription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":13,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"8":{"uid":8,"key":[],"keysecondary":[],"comment":"蜜语","content":"{{HONEY_HISTORY}}","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":1,"disable":true,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":14,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"9":{"uid":9,"key":[],"keysecondary":[],"comment":"万象-任务","content":"\n{{WANGXIANG_TASKS}}\n\n【万象任务进度更新规则】\n请根据上方已接任务信息判断用户是否在本轮剧情中实际推进了任务。\n\n只有当剧情中明确完成、推进了某个任务目标时，才在正文回复的最末尾输出任务进度标签；没有实际进展时不要输出。\n\n任务名称和目标名称必须与上方任务信息完全一致，不得改名、缩写或自行新增目标。进度只能增加，不能倒退，也不能超过目标总数。\n\n必须严格使用以下格式，不要使用代码块：\n\n<任务进度>\n任务名称｜目标名称：当前进度/总进度\n</任务进度>\n\n同时推进多个目标时，每个目标单独一行，例如：\n\n<任务进度>\n调查旧城区｜抵达调查地点：1/1\n调查旧城区｜收集异常样本：2/4\n护送医疗队｜护送队员抵达避难所：3/6\n</任务进度>\n\n只输出本轮发生变化的目标，不要重复输出没有变化的目标。标签必须放在正文最末尾。","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":4,"disable":true,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":6,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":8,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"10":{"uid":10,"key":[],"keysecondary":[],"comment":"万象-购物","content":"{{WANGXIANG_ORDERS}}\n\n\n请根据上诉预计到达时间与当前时间对比，一旦大于送达时间，必须在当前正文的末尾输出快递投递的标签格式如下：\n<快递投递>\n商品名称：\n送达时间：\n</快递投递>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":4,"disable":true,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":6,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":9,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"11":{"uid":11,"key":[],"keysecondary":[],"comment":"微信APP-朋友圈消息记录","content":"{{MOMENTS_HISTORY}}","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":4,"disable":true,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":6,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"12":{"uid":12,"key":[],"keysecondary":[],"comment":"短信","content":"在正文末尾，如剧情正文后，可根据剧情生成短信。\n拟真短信:除正常的好友短信外,可随机生成广告推销(含NSFW)、垃圾短信、天气预报等真实拟真的短信通知.\n短信来源:所有短信必须有明确的来源命名(如:具体的联系人名称、匿名短信或广告推送等).\n多条短信：多条短信可使用---分割，包裹在同一个<短信></ 短信>内。\n\n格式：\n<短信>\n[发件方姓名]\n内容：\n发送时间：HH:mm\n---\n[发件方姓名]\n内容：\n发送时间：HH:mm\n</ 短信>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":4,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":null,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":7,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"13":{"uid":13,"key":[],"keysecondary":[],"comment":"通话APP-通话/短信聊天记录","content":"{{PHONE_APP_HISTORY}}","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":1,"disable":false,"ignoreBudget":false,"excludeRecursion":false,"preventRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"u